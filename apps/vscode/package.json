{
  "name": "session-lens-vscode",
  "displayName": "Session Lens",
  "description": "Claude Code usage by day \u2192 session \u2192 request \u2192 context line items",
  "version": "0.1.0",
  "publisher": "local",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "dist/extension.cjs",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "sessionLens.open",
        "title": "Session Lens: Open",
        "icon": "$(graph)"
      },
      {
        "command": "sessionLens.openBeside",
        "title": "Session Lens: Open to the Side"
      }
    ],
    "configuration": {
      "title": "Session Lens",
      "properties": {
        "sessionLens.projectsDirs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Claude Code transcript folders. Empty = ~/.claude/projects (or $CLAUDE_CONFIG_DIR/projects)."
        },
        "sessionLens.statusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show today's estimated cost in the status bar; click it to open Session Lens."
        }
      }
    },
    "viewsContainers": {
      "panel": [
        {
          "id": "sessionLens",
          "title": "Session Lens",
          "icon": "$(graph)"
        }
      ]
    },
    "views": {
      "sessionLens": [
        {
          "type": "webview",
          "id": "sessionLens.view",
          "name": "Usage"
        }
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "package": "npm run build && npx --yes @vscode/vsce@3 package --no-dependencies -o session-lens.vsix"
  },
  "devDependencies": {
    "@session-lens/core": "0.1.0",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pman13a/session-lens.git"
  }
}
